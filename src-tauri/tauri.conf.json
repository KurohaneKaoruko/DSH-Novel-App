{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH-Novel",
  "version": "1.0.2",
  "identifier": "io.github.kurohanekaoruko.dsh-novel",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DSH-Novel",
        "width": 1480,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 660,
        "url": "loading.html",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "staging/kernel": "kernel",
      "staging/agents": "agents",
      "staging/scripts": "scripts",
      "staging/node": "node"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
